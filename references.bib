@article{dyllaFractureStrengthDistribution2016,
  title = {Fracture {{Strength Distribution}} of {{Individual Nb3Sn Filaments}}},
  author = {Dylla, M. T. and Schultz, S. E. and Jewell, M. C.},
  date = {2016-12},
  journaltitle = {IEEE Transactions on Applied Superconductivity},
  volume = {26},
  number = {8},
  pages = {1--7},
  issn = {1051-8223},
  doi = {10.1109/TASC.2016.2602819},
  abstract = {Brittle fracture of Nb3Sn filaments is one mechanism by which the current-carrying capacity of composite Nb3Sn wires is degraded. However, there are relatively little data in the literature on the intrinsic material fracture properties of Nb3Sn filaments, because the complex composite structure (matrix, secondary phases, and defects such as voids) acts as an integrated mechanical unit. In this study, we extracted individual Nb3Sn filaments from a fusion-style Nb3Sn composite wire and conducted tensile testing to determine the fracture strength distribution of the isolated filaments. The distribution is modeled using a Weibull function. The relative fracture propensity of fully reacted filaments versus those with unreacted Nb cores is compared. The presence of a Nb core reduces, on average, the fracture strength of a filament by 38\% and the strain to failure by 29\%. Understanding the fracture probability of Nb3Sn as a function of both stress and volume will allow strand and conductor modeling efforts to more accurately represent the relative contributions of fracture and other effects (such as plasticity) to irreversible current density degradation, and may assist wire manufacturers in assessing the mechanical impact of wire design changes.},
  issue = {8},
  keywords = {⛔ No INSPIRE recid found,brittle fracture,complex composite structure,composite materials,composite wires,conducted tensile testing,conductor modeling,Conductors,current density,current-carrying capacity,failure (mechanical),failure strain,filaments,Fracture mechanics,fracture probability,fracture strength distribution,fracture toughness,fusion-style composite wire,impact (mechanical),integrated mechanical unit,intrinsic material fracture,irreversible current density degradation,isolated filaments,mechanical impact,Nb3Sn,niobium alloys,niobium-tin,Niobium-tin,plasticity,Strain,Stress,stress measurement,stress-strain relations,superconducting filaments and wires,tensile testing,Testing,tin alloys,type II superconductors,Weibull distribution,Weibull function,Wires},
  file = {C\:\\Users\\dreyn\\Zotero\\storage\\E5367R28\\Dylla et al. - 2016 - Fracture Strength Distribution of Individual Nb3Sn.pdf;C\:\\Users\\dreyn\\Zotero\\storage\\P4CBPK4Q\\7552540.html}
}

@article{eastonPredictionStressState1980,
  title = {A Prediction of the Stress State in {{Nb}}{\textsubscript{3}}{{Sn}} Superconducting Composites},
  author = {Easton, D. S. and Kroeger, D. M. and Specking, W. and Koch, C. C.},
  date = {1980},
  journaltitle = {Journal of Applied Physics},
  volume = {51},
  number = {5},
  pages = {2748},
  issn = {00218979},
  doi = {10.1063/1.327937},
  url = {http://scitation.aip.org/content/aip/journal/jap/51/5/10.1063/1.327937},
  urldate = {2016-06-03},
  abstract = {The critical current Ic as a function of applied tensile strain depends upon the residual stress state that exists in Nb3Sn bronze‐process composite conductors after cooling from the reaction temperature to 4.2 K. This paper presents a simple analytical method to predict the residual stress state and the stress‐strain curves of Nb3Sn composites at 4.2 K. The method requires only a prior knowledge of the volume fraction of the composite components and the percentage of Nb converted to Nb3Sn. Experimental results and analytically derived values are compared and good agreement is generally found.},
  issue = {5},
  langid = {english},
  keywords = {⛔ No INSPIRE recid found},
  annotation = {00068},
  file = {C\:\\Users\\dreyn\\Zotero\\storage\\2EJXC6E9\\Easton et al_1980_A prediction of the stress state in Nb3Sn superconducting composites.pdf;C\:\\Users\\dreyn\\Zotero\\storage\\B6HCW9XA\\Easton et al. - 1980 - A prediction of the stress state in Nb3Sn supercon.pdf}
}

