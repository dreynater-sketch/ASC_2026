@article{Viklund:2023nlq,
  title = {Improving {{Nb3Sn Cavity Performance Using Centrifugal Barrel Polishing}}},
  author = {Viklund, Eric and Seidman, David N. and Burk, David and Posen, Sam},
  date = {2024-01-16},
  journaltitle = {Supercond. Sci. Technol.},
  volume = {37},
  number = {2},
  eprint = {2305.10226},
  eprinttype = {arXiv},
  eprintclass = {physics.acc-ph},
  pages = {025009},
  doi = {10.1088/1361-6668/ad0b2d},
  url = {http://arxiv.org/abs/2305.10226},
  urldate = {2024-03-06},
  abstract = {In this study we will show a new method of polishing for Nb3Sn cavities known as centrifugal barrel polishing (CBP). Using this method, Nb3Sn coated samples are polished to a surface roughness comparable to a traditional Nb cavity after electropolishing (EP). We also investigate different methods of cleaning the Nb3Sn surface after CBP to remove residual abrasive particles. The polished Nb3Sn surface is analyzed using confocal laser microscopy, and scanning electron microscopy (SEM) is used to image the surface and measure the surface roughness after polishing. Transmission electron microscopy (TEM) is also used for high resolution analysis of the surface after polishing. Finally, we show that centrifugal barrel polishing can improve the performance of a Nb3Sn SRF cavity.},
  keywords = {Physics - Accelerator Physics},
  annotation = {1 citations (INSPIRE 2024/3/6)\\
