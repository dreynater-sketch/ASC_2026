  pages = {043022},
  issn = {2470-0010, 2470-0029},
  doi = {10.1103/PhysRevD.110.043022},
  url = {http://arxiv.org/abs/2208.03183},
  urldate = {2025-05-20},
  abstract = {Wavelike, bosonic dark matter candidates like axions and dark photons can be detected using microwave cavities known as haloscopes. Traditionally, haloscopes consist of tunable copper cavities operating in the TM\$\_\{010\}\$ mode, but ohmic losses have limited their performance. In contrast, superconducting radio frequency (SRF) cavities can achieve quality factors of \$\textbackslash sim 10\textasciicircum\{10\}\$, perhaps five orders of magnitude better than copper cavities, leading to more sensitive dark matter detectors. In this paper, we first derive that the scan rate of a haloscope experiment is proportional to the loaded quality factor \$Q\_L\$, even if the cavity bandwidth is much narrower than the dark matter halo line shape. We then present a proof-of-concept search for dark photon dark matter using a nontunable ultrahigh quality SRF cavity. We exclude dark photon dark matter with kinetic mixing strengths of \$\textbackslash chi {$>$} 1.5\textbackslash times 10\textasciicircum\{-16\}\$ for a dark photon mass of \$m\_\{A\textasciicircum\{\textbackslash prime\}\} = 5.35\textbackslash mu\$eV, achieving the deepest exclusion to wavelike dark photons by almost an order of magnitude.},
  keywords = {Astrophysics - Instrumentation and Methods for Astrophysics,High Energy Physics - Experiment,High Energy Physics - Phenomenology},
  annotation = {25 citations (INSPIRE 2025/7/1)\\
23 citations w/o self (INSPIRE 2025/7/1)},
  file = {C\:\\Users\\dreyn\\Zotero\\storage\\X4UCLNVU\\Cervantes et al. - 2024 - Deepest sensitivity to wavelike dark photon dark m.pdf;C\:\\Users\\dreyn\\Zotero\\storage\\MGS3HAYZ\\2208.html}
}

