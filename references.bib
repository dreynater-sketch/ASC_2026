@article{zhangRoleCopperFormation2023,
  title = {The Role of Copper in the Formation of the {{Nb3Sn}} Superconducting Phase},
  author = {Zhang, Zerong and Gao, Zhan and Wang, Yanan and Meng, Jianli and Cheng, Junsheng and Wang, Qiuliang},
  date = {2023-04},
