  shorttitle = {Effect of the Density of States at the {{Fermi}} Level on Defect Free Energies and Superconductivity},
  author = {Sitaraman, Nathan S. and Kelley, Michelle M. and Porter, Ryan D. and Liepe, Matthias U. and Arias, Tomás A. and Carlson, Jared and Pack, Alden R. and Transtrum, Mark K. and Sundararaman, Ravishankar},
