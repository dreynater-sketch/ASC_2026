@article{Posen:2020kei,
  title = {Advances in {{Nb}} {\textsubscript{3}} {{Sn}} Superconducting Radiofrequency Cavities towards First Practical Accelerator Applications},
  author = {Posen, S and Lee, J and Seidman, D N and Romanenko, A and Tennis, B and Melnychuk, O S and Sergatskov, D A},
  date = {2021-01-12},
  journaltitle = {Supercond. Sci. Technol.},
  volume = {34},
