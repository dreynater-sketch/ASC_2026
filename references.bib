@article{badicaRelationshipArchitectureFilament2006,
  title = {Relationship between Architecture, Filament Breakage and Critical Current Decay in {{Nb}}\$\textbackslash less\$sub\$\textbackslash greater\$3\$\textbackslash less\$/sub\$\textbackslash greater\${{Sn}} Composite Wires Repeatedly in-Plane Bent at Room Temperature},
  author = {Badica, P. and Awaji, S. and Oguro, H. and Nishijima, G. and Watanabe, K.},
  date = {2006-02},
  journaltitle = {Supercond. Sci. Technol.},
  volume = {19},
  number = {4},
  pages = {323--332},
  publisher = {IOP Publishing},
  issn = {0953-2048},
  doi = {10.1088/0953-2048/19/4/014},
  url = {https://doi.org/10.1088/0953-2048/19/4/014},
  urldate = {2022-05-20},
  abstract = {Six Nb3Sn composite wires with different architectures (‘central and near-the-edge reinforcement’) were repeatedly in-plane bent at room temperature (in-plane ‘pre-bending’). Breakage behaviour was revealed from scanning electron microscopy observations by semi-quantitative analysis of the filament crack formation and evolution. Cracks are formed in the transversal and longitudinal directions. Transversal cracks show some tolerance to the applied bending strain due to the fact that filaments are composite materials; residual Nb core can arrest development of a partial transversal crack initiated in the Nb3Sn outer part of the filament. Together with the density of cracks C and the evolution of this parameter with pre-bending strain, εpb, in different regions of the wire, R–εpb curves are important to understand breakage behaviour of the wires. R is the ratio (number of full transversal cracks)/(number of full transversal cracks + number of partial transversal cracks). Parameters C and R allow us to reveal and satisfactorily understand the wire architecture—breakage—critical current decay relationship when pre-bending treatment is applied. As a consequence, breakage criteria necessary to minimize Ic decay were defined and the positive influence of the reinforcement in preventing breakage was observed. It was also found that, in this regard, more Nb in the CuNb reinforcement, for the investigated wires, is better, if the heat treatment for the wire synthesis is performed at 670 °C for 96 h. A different heat treatment, 650 °C for 240 h, is less efficient in preventing filament breakage. Our results suggest the possibility of control and improvement of the breakage susceptibility of the filaments in the wires and, hence, of the bending Ic decay, through the wise design of the wire architecture (i.e. by correlating design with the choice of composing materials and heat treatments).},
  issue = {4},
  langid = {english},
  keywords = {⛔ No INSPIRE recid found},
  annotation = {8 citations (Crossref) [2022-05-21]},
  file = {C:\Users\dreyn\Zotero\storage\LYP9PVER\Badica et al_2006_Relationship between architecture, filament breakage and critical current decay.pdf}
}

@article{Baffari:2022qri,
  title = {Effect of the {{Sub-Elements Layout}} on the {{Electro-Mechanical Properties}} of {{High Jc Nb3Sn Wires Under Transverse Load}}: {{Numerical Simulations}}},
  shorttitle = {Effect of the {{Sub-Elements Layout}} on the {{Electro-Mechanical Properties}} of {{High Jc Nb3Sn Wires Under Transverse Load}}},
  author = {Baffari, D. and Bordini, B.},
  date = {2022-09},
  journaltitle = {IEEE Trans. Appl. Supercond.},
  volume = {32},
  number = {6},
  pages = {6001306},
  issn = {1558-2515},
  doi = {10.1109/TASC.2022.3163060},
  abstract = {The brittle intermetallic Nb \textsubscript{3} Sn superconductor is currently being used to develop high field magnets in the framework of the Hi-Luminosity upgrade of the Large Hadron Collider at CERN. Despite its excellent superconductive properties,Nb \textsubscript{3} Sn wires suffer from significant critical current  {$<$}italic xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink"{$>$}I\textsubscript{c}  reduction due to the transverse load applied during the magnets’ assembly and energization. In high critical current density ( {$<$}italic xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink"{$>$}J\textsubscript{c}  {$>$}1200 A/mm \textsuperscript{2}  at 15 T, 4.22 K) RRP and PIT Rutherford cables when applying a transverse load of 150 MPa, the  {$<$}italic xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink"{$>$}I\textsubscript{c}  (12 T, 4.22 K) is reduced respectively by about 10-15\% and 20\%. At this level of transverse load, the  {$<$}italic xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink"{$>$}I\textsubscript{c}  reduction is practically reversible, and it is due to the strain induced in the superconductor, which reduces its upper critical field  {$<$}italic xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink"{$>$}B\textsubscript{c2}.  Because of the  {$<$}italic xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink"{$>$}B\textsubscript{c2}  reduction, at 19 T and 4.22 K, with a load of 150 MPa, the same cables are expected to experience an  {$<$}italic xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink"{$>$}I\textsubscript{c}  reduction up to 40\%. Further increasing the transverse loads, cracks in the superconductor also start to reduce (irreversibly) the  {$<$}italic xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink"{$>$}I\textsubscript{c} . A dedicated FEM 3D numerical model coupled with a  {$<$}italic xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink"{$>$}J\textsubscript{c}  scaling law has been developed to predict the electro-mechanical behaviour of RRP and PIT wires under transverse loads in the reversible regime. By using this model, the effects of different geometrical factors have been studied to identify the key parameters that allow limiting the effect of transverse loads on the  {$<$}italic xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink"{$>$}I\textsubscript{c}  reduction under transverse load. In particular, this paper deals with the role of the: production technologies diameter, sub-elements layout, heat treatment and precompression.},
  eventtitle = {{{IEEE Transactions}} on {{Applied Superconductivity}}},
  issue = {6},
  keywords = {Conductors,Critical current scaling,FEM,Layout,Load modeling,Nb3Sn,rutherford cable,Strain,Superconducting cables,Superconducting magnets,superconductor,transverse load,Wires},
  annotation = {0 citations (INSPIRE 2024/2/26)\\
0 citations w/o self (INSPIRE 2024/2/26)},
