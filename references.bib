  volume = {15},
  number = {2},
  pages = {3652--3655},
  issn = {1558-2515},
  doi = {10.1109/TASC.2005.849382},
  abstract = {We have developed a device for the electro-mechanical characterization of long high current technical LTS wires and tapes up to 21 T. Our device is based on the concept of the Walters spring (WASP), which allows us to measure long length wires (up to 80 cm) and to obtain an absolute measurement of the strain value. The long length of the conductors allowed us to measure the V-I relation under strain over three decades of electric field (down to 0.01 /spl mu/V/cm) with currents up to 1000 A. This constitutes a progress in view of the characterization of the conductors for NMR applications at high field, which must operate in persistent mode. We report on I/sub c/ vs. strain measurements at fields up to 21 T for various types of Nb/sub 3/Sn wires prepared by different techniques (industrial wires as well as wires prepared in our laboratory) and for a copper cladded Nb/sub 3/Al wire, prepared at NIMS (Tsukuba). We show that the new, sharper criterion gives a new insight on the reversible behavior of the I vs. strain curve as well as of the variation of the exponential n factor under uniaxial tensile strain. The results on Nb/sub 3/Sn are analyzed in the context of the scaling laws proposed by J. Ekin.},
  eventtitle = {{{IEEE Transactions}} on {{Applied Superconductivity}}},
  issue = {2},
  keywords = {⛔ No INSPIRE recid found,Capacitive sensors,Conductors,Critical current,Current measurement,high field,Length measurement,Niobium,strain,Strain measurement,Tensile strain,Tin,Wires},
  annotation = {00014},
  file = {C\:\\Users\\dreyn\\Zotero\\storage\\SK9PTAZX\\Uglietti_Seeber_et_al_2005_Critical_current_vs_.pdf;C\:\\Users\\dreyn\\Zotero\\storage\\VHYMBSDR\\1440463.html}
}

