@article{Kafle:2014xfa,
  title = {On the {{Shoulders}} of {{Giants}}: {{Properties}} of the {{Stellar Halo}} and the {{Milky Way Mass Distribution}}},
  shorttitle = {On the {{Shoulders}} of {{Giants}}},
  author = {Kafle, Prajwal R. and Sharma, Sanjib and Lewis, Geraint F. and Bland-Hawthorn, Joss},
  date = {2014-09-24},
  journaltitle = {Astrophys. J.},
  volume = {794},
  number = {1},
  eprint = {1408.1787},
  eprinttype = {arXiv},
  eprintclass = {astro-ph.GA},
  pages = {59},
  issn = {1538-4357},
  doi = {10.1088/0004-637X/794/1/59},
  url = {http://arxiv.org/abs/1408.1787},
  urldate = {2024-01-19},
  abstract = {Halo stars orbit within the potential of the Milky Way and hence their kinematics can be used to understand the underlying mass distribution. However, the inferred mass distribution depends sensitively upon assumptions made on the density and the velocity anisotropy profiles of the tracers. Also, there is a degeneracy between the parameters of the halo and that of the disk or bulge. Here, we decompose the Galaxy into bulge, disk and dark matter halo and then model the kinematic data of the halo BHB and K-giants from the SEGUE. Additionally, we use the gas terminal velocity curve and the Sgr A\$\textasciicircum *\$ proper motion. With \$R\_\textbackslash odot = 8.5\$kpc, our study reveals that the density of the stellar halo has a break at \$17.2\textasciicircum\{+1.1\}\_\{-1.0\}\$ kpc, and an exponential cut-off in the outer parts starting at \$97.7\textasciicircum\{+15.6\}\_\{-15.8\}\$kpc. Also, we find the velocity anisotropy is radially biased with \$\textbackslash beta\_s= 0.4\textbackslash pm\{0.2\}\$ in the outer halo. We measure halo virial mass \$M\_\{\textbackslash text\{vir\}\} = 0.80\textasciicircum\{+0.31\}\_\{-0.16\} \textbackslash times 10\textasciicircum\{12\} M\_\{\textbackslash odot\}\$, concentration \$c=21.1\textasciicircum\{+14.8\}\_\{-8.3\}\$, disk mass of \$0.95\textasciicircum\{+0.24\}\_\{-0.30\}\textbackslash times10\textasciicircum\{11\} M\_\{\textbackslash odot\}\$, disk scale length of \$4.9\textasciicircum\{+0.4\}\_\{-0.4\}\$ kpc and bulge mass of \$0.91\textasciicircum\{+0.31\}\_\{-0.38\} \textbackslash times 10\textasciicircum\{10\} M\_\{\textbackslash odot\}\$. The mass of halo is found to be small and this has important consequences. The giant stars reveal that the outermost halo stars have low velocity dispersion interestingly suggesting a truncation of the stellar halo density rather than a small overall mass of the Galaxy. Our estimates of local escape velocity \$v\_\{\textbackslash rm esc\} = 550.9\textasciicircum\{+32.4\}\_\{-22.1\}\$ kms\$\textasciicircum\{-1\}\$ and dark matter density \$\textbackslash rho\textasciicircum\{\textbackslash rm DM\}\_\{\textbackslash odot\} = 0.0088\textasciicircum\{+0.0024\}\_\{-0.0018\} M\_\{\textbackslash odot\} \{\textbackslash rm pc\textasciicircum\{-3\}\} \$ (\$0.35\textasciicircum\{+0.08\}\_\{-0.07\}\$ GeV cm\$\textasciicircum\{-3\}\$) are in good agreement with recent estimates. Some of the above estimates are depended on the adopted value of \$R\_\textbackslash odot\$ and of outer power-law index of the tracer number density.},
  keywords = {Astrophysics - Astrophysics of Galaxies,Astrophysics - Cosmology and Nongalactic Astrophysics},
  annotation = {116 citations (INSPIRE 2024/1/19)\\
109 citations w/o self (INSPIRE 2024/1/19)},
  file = {C\:\\Users\\dreyn\\Zotero\\storage\\HI9I448Q\\Kafle et al. - 2014 - On the Shoulders of Giants Properties of the Stel.pdf;C\:\\Users\\dreyn\\Zotero\\storage\\Q6WW8WTG\\1408.html}
}

