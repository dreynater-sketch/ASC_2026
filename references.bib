@article{larkinPinningTypeII1979,
  title = {Pinning in Type {{II}} Superconductors},
  author = {Larkin, A. I. and family=Ovchinnikov, given=Yu. N., given-i={{Yu}}N},
  date = {1979-02-01},
  journaltitle = {J Low Temp Phys},
