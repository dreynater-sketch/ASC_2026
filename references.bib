  author = {Cervantes, Raphael and Aumentado, Jose and Braggio, Caterina and Giaccone, Bianca and Frolov, Daniil and Grassellino, Anna and Harnik, Roni and Lecocq, Florent and Melnychuk, Oleksandr and Pilipenko, Roman and Posen, Sam and Romanenko, Alexander},
  date = {2024-08-12},
  journaltitle = {Phys. Rev. D},
  volume = {110},
  number = {4},
  eprint = {2208.03183},
  eprinttype = {arXiv},
