@article{lachmannThermodynamicRemodellingCu2022,
  title = {Thermodynamic Re-Modelling of the {{Cu}}–{{Nb}}–{{Sn}} System: {{Integrating}} the Nausite Phase},
  shorttitle = {Thermodynamic Re-Modelling of the {{Cu}}–{{Nb}}–{{Sn}} System},
  author = {Lachmann, Jonas and Kriegel, Mario J. and Leineweber, Andreas and Shang, Shun-Li and Liu, Zi-Kui},
  date = {2022-06},
  journaltitle = {Calphad},
