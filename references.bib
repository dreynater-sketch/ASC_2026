  author = {Wang, X. and Ambrosio, G. and Chlachidze, G. and Collings, E. W. and Dietderich, D. R. and DiMarco, J. and Felice, H. and Ghosh, A. K. and Godeke, A. and Gourlay, S. A. and Marchevsky, M. and Prestemon, S. O. and Sabbi, G. and Sumption, M. D. and Velev, G. V. and Xu, X. and Zlobin, A. V.},
  date = {2015},
  journaltitle = {IEEE Trans. Appl. Supercond.},
  volume = {25},
  number = {3},
  pages = {4003006},
  issn = {1558-2515},
  doi = {10.1109/TASC.2014.2385932},
  abstract = {Persistent magnetization currents are induced in superconducting filaments during the current ramping in magnets. The resulting perturbation to the design magnetic field leads to field quality degradation, particularly at low field, where the effect is stronger relative to the main field. The effects observed in NbTi accelerator magnets were reproduced well with the critical-state model. However, this approach becomes less accurate for the calculation of the persistent-current effects observed in Nb\_3Sn accelerator magnets. Here, a finite-element method based on the measured strand magnetization is validated using three state-of-the-art Nb\_3Sn accelerator magnets featuring different subelement diameters, conductor critical currents, magnet designs, and test temperatures. The temperature dependence of the persistent-current effects is reproduced. Based on the validated model, the impact of conductor design on the persistent-current effects is discussed. The strengths, limitations, and possible improvements of the approach are also discussed.},
  eventtitle = {{{IEEE Transactions}} on {{Applied Superconductivity}}},
  issue = {3},
  keywords = {accelerator magnets,Accelerator magnets,conductor critical currents,Conductors,critical-state model,Current measurement,current ramping,field quality,Field quality,field quality degradation,finite element analysis,finite-element models,magnet designs,magnetic field design,magnetisation,magnetization,Magnetization,measured strand magnetization,Nb3Sn,Nb3Sn accelerator magnets,NbTi,niobium compounds,Niobium-tin,particle accelerators,persistent magnetization currents,persistent-current effects,subelement diameters,superconducting filaments,superconducting magnets,Superconducting magnets,temperature dependence,Temperature measurement,test temperatures},
  annotation = {9 citations (INSPIRE 2023/9/5)\\
0 citations w/o self (INSPIRE 2023/9/5)},
  file = {C\:\\Users\\dreyn\\Zotero\\storage\\Q26R47ZS\\Wang et al. - 2015 - Validation of Finite-Element Models of Persistent-.pdf;C\:\\Users\\dreyn\\Zotero\\storage\\WJEVKFFW\\7001568.html}
}

@article{Wang:2024xau,
  title = {The Impact of Laser Treatment on the Microstructure and Properties of Bronze Route {{Nb3Sn}} Thin Films},
  author = {Wang, Changlin and Lu, Ming and Zhang, Jing and Zhang, Bohao and Chu, Qingwei and Tan, Teng and Zhu, Tongtong and Wu, Andong and Zhang, Shengxue and He, Yuan},
  date = {2024-10-28},
  journaltitle = {Appl. Surf. Sci.},
  volume = {682},
  pages = {161646},
  issn = {0169-4332},
  doi = {10.1016/j.apsusc.2024.161646},
  url = {https://www.sciencedirect.com/science/article/pii/S0169433224023626},
  urldate = {2025-05-22},
  abstract = {•The first time using a flat-top laser beam to achieve surface annealing of Nb3Sn film.•Detailed material analysis: structure, processing, properties, and performance.•Reducing defects and decreasing surface roughness of Nb3Sn.•Improving the bonding between Nb3Sn and substrate.•The work reveals the process and mechanism during laser treatment of Nb3Sn. Nb3Sn thin film cavities are new generation of superconducting cavities which have the potential to replace traditional pure niobium cavities owing to their superior theoretical radio frequency (RF) performance. Higher theoretical acceleration gradient and quality factor give Nb3Sn cavities more possibilities in the future. But the RF performance of Nb3Sn cavities is limited by the quench and field emission attributed to their surface defects and there is still none effective way to solve the problem. This study emphasizes a novel Nb3Sn surface treatment method to improve the surface state: laser treatment, achieving a reduction in surface roughness, as well as weakening the Nb3Sn’s grain boundaries and strengthening the bonding between film and substrate. It can also control film thickness without cracks. The issues related to surface improvement mentioned above are tied to the RF loss of Nb3Sn cavities. In this study, a feasible path will be provided for reducing the RF loss and improve the RF performance of Nb3Sn in the future.},
  keywords = {Bronze method,Laser annealing,NbSn,Superconductivity,Thermodynamic simulation},
  annotation = {0 citations (INSPIRE 2025/7/1)\\
0 citations w/o self (INSPIRE 2025/7/1)}
}

