@article{zengKondoEffectSuperconductivity2021,
  title = {Kondo Effect and Superconductivity in Niobium with Iron Impurities},
  author = {Zeng, Hansong and Zhou, Dan and Liang, Guoqing and Tang, Rujun and Hang, Zhi H. and Hu, Zhiwei and Pei, Zixi and Ling, X. S.},
  date = {2021-07-09},
  journaltitle = {Sci Rep},
