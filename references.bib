@article{Valente-Feliciano:2015qkf,
  title = {Material {{Quality}} \&amp; {{SRF Performance}} of {{Nb Films Grown}} on {{Cu}} via {{ECR Plasma Energetic Condensation}}},
  author = {Valente-Feliciano, Anne-Marie and Aull, Sarah and Eremeev, Grigory and Proslier, Thomas and Reece, Charles and Spradlin, Joshua},
  namea = {E. (Ed.), Robert, Laxdal and Jana (Ed.), Thomson and RW (Ed.), Volker, Schaa},
  nameatype = {collaborator},
  date = {2015-12},
  journaltitle = {Proceedings of the 17th International Conference on RF Superconductivity},
  volume = {SRF2015},
  pages = {4 pages, 3.787 MB},
  publisher = {JACoW, Geneva, Switzerland},
  doi = {10.18429/JACoW-SRF2015-TUPB029},
  url = {http://accelconf.web.cern.ch/AccelConf/DOI/SRF2015/JACoW-SRF2015-TUPB029.html},
  urldate = {2023-11-14},
  abstract = {The RF performance of bulk Nb cavities has continuously improved over the years and is approaching the intrinsic limit of the material. Although some margin seems still available with processes such as N surface doping, long term solutions for SRF surfaces efficiency enhancement need to be pursued. Over the years, Nb/Cu technology, despite its shortcomings, has positioned itself as an alternative route for the future of superconducting structures used in accelerators. Significant progress has been made in recent years in the development of energetic deposition techniques such as Electron Cyclotron Resonance (ECR) plasma deposition. Nb films with very high material quality have then been produced by varying the deposition energy alluding to the promise of performing SRF films. This paper presents RF measurements, correlated with surface and material properties, for Nb films showing how, by varying the film growth conditions, the Nb film quality and surface resistance can be altered and how the Q-slope can be eventually overcome.},
  isbn = {9783954501786},
  langid = {english},
  keywords = {Accelerator Physics,Fundamentals SRF R&amp;D - Other Materials},
  annotation = {3 citations (INSPIRE 2023/11/14)\\
2 citations w/o self (INSPIRE 2023/11/14)}
}

