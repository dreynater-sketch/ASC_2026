@article{zhouDirectMeasurementInterFilament2011,
  title = {Direct {{Measurement}} of {{Inter-Filament Resistance}} in {{Superconducting Multifilamentary NbTi}} and {{Nb}}{\textsubscript{3}}{{Sn Strands}}},
  author = {Zhou, C. and family=Lanen, given=E. P. A., prefix=van, useprefix=true and Veldhuis, D. and family=Kate, given=H. H. J., prefix=ten, useprefix=true and Dhalle, M. and Nijhuis, A.},
