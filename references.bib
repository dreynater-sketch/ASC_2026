  shorttitle = {The {{Effect}} of {{Hydrostatic Pressure}} on the {{Superconducting}} and {{Structural Properties}} of {{Nb}} \$\_3\${{Sn}}},
  author = {Loria, Rita and De Marzi, Gianluca and Anzellini, Simone and Muzzi, Luigi and Pompeo, Nicola and Gala, Fabrizio and Silva, Enrico and Meneghini, Carlo},
  date = {2017-06},
  journaltitle = {IEEE Trans. Appl. Supercond.},
