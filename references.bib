@article{anBIdirectionalHomogenizationMethod2022,
  title = {BIdirectional homogenization method for accurate analysis of mechanical behaviors of Nb\textsubscript{3}Sn superconducting coils},
  author = {An, He and Jianbo, Li and Cun, Xue},
  date = {2022-05-18},
  journaltitle = {lxxb},
  volume = {54},
  number = {5},
  pages = {1--17},
  publisher = {力学学报},
  issn = {0459-1879},
  doi = {10.6052/0459-1879-22-033},
  url = {https://lxxb.cstam.org.cn/en/article/doi/10.6052/0459-1879-22-033},
  urldate = {2022-03-19},
  abstract = {Nb\textsubscript{3}Sn superconducting magnets can produce high magnetic fields during operation, and the Nb\textsubscript{3}Sn superconducting coils subjected to strong electromagnetic force can result in great mechanical strain. The strain sensitivity of Nb\textsubscript{3}Sn superconducting material will degrade the critical performance of the Nb\textsubscript{3}Sn magnet coil, which has a significant impact on the safety and stability of magnets. Therefore, it is of great scientific significance to accurately calculate the mechanical behavior of superconducting magnets under electromagnetic force. Nb\textsubscript{3}Sn superconducting magnets are mainly made of superconducting wires wound into coil structure and solidified by epoxy resin. Nb\textsubscript{3}Sn superconducting wire is a composite structure mainly made of multiple microfilament embedded in a copper matrix. Therefore, the size from superconducting filaments to superconducting magnets spans several orders of magnitude, which brings challenges for accurate analysis of the mechanical deformation of superconducting coils. Firstly, the representative element (RVE) homogenization method is used to analyze the equivalent mechanical parameters of the whole coil. By comparing the results of the equivalent homogenization model and the actual structure of the coil, it is found that there are significant errors in the equivalent homogenization model. Therefore, we propose a bidirectional homogenization analysis method with high accuracy and low computational cost to study the stress-strain distribution of each component material (Nb\textsubscript{3}Sn filament, copper, and epoxy resin) in the superconducting coil. This method does not require large-scale numerical modeling and the results of this method are in good agreement with that of the actual composite coils, which verifies the effectiveness and accuracy of this method. Finally, based on the proposed multi-scale method, we discuss the stress-strain variations of each layer of the Nb\textsubscript{3}Sn superconducting coil versus turns and layers under the electromagnetic force in detail.},
  issue = {5},
  langid = {chinese},
  keywords = {⛔ No INSPIRE recid found},
  file = {C\:\\Users\\dreyn\\Zotero\\storage\\W3FXP9WB\\An et al. - 2022 - BIdirectional homogenization method for accurate a.pdf;C\:\\Users\\dreyn\\Zotero\\storage\\V5GHZS4Z\\0459-1879-22-033.html}
}

