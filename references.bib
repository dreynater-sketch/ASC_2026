  urldate = {2024-01-19},
  abstract = {We present first results and future plans for the Oscillating Resonant Group AxioN (ORGAN) experiment, a microwave cavity axion haloscope situated in Perth, Western Australia designed to probe for high mass axions motivated by several theoretical models. The first stage focuses around 26.6 GHz in order to directly test a claimed result, which suggests axions exist at the corresponding mass of \$110\textasciitilde\textbackslash mu\$eV. Later stages will move to a wider scan range of 15-50 GHz (\$60-210\textasciitilde\textbackslash mu \$eV). We present the results of the pathfinding run, which sets a limit on \$g\_\{a\textbackslash gamma\textbackslash gamma\}\$ of \$2.02\textbackslash times 10\textasciicircum\{-12\} \$eV\$\textasciicircum\{-1\}\$ at 26.531 GHz, or 110\textasciitilde\$\textbackslash mu\$eV, in a span of 2.5 neV (shaped by the Lorentzian resonance) with \$90 \textbackslash\%\$ confidence. Furthermore, we outline the current design and future strategies to eventually attain the sensitivity to search for well known axion models over the wider mass range.},
  keywords = {High Energy Physics - Experiment,Physics - Instrumentation and Detectors},
  annotation = {287 citations (INSPIRE 2024/1/19)\\
