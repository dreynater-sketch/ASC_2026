  publisher = {American Physical Society},
  doi = {10.1103/PhysRevApplied.17.L061005},
  url = {https://link.aps.org/doi/10.1103/PhysRevApplied.17.L061005},
  urldate = {2023-11-16},
  abstract = {A high-quality factor microwave resonator in the presence of a strong magnetic field could have a wide range of applications, such as axion dark matter searches where the two aspects must coexist to enhance the experimental sensitivity. We introduce a polygon-shaped cavity design with bi-axially textured YBa\$\_\{2\}\$Cu\$\_\{3\}\$O\$\_\{7-x\}\$ superconducting tapes covering the entire inner wall. Using a 12-sided polygon cavity, we obtain substantially improved quality factors of the TM\$\_\{010\}\$ mode at 6.9 GHz at 4 K with respect to a copper cavity and observe no considerable degradation in the presence of magnetic fields up to 8 T. This corresponds to the first demonstration of practical applications of superconducting radio frequency technology for axion and other research areas requiring low loss in a strong magnetic field. We address the importance of the successful demonstration and discuss further improvements.},
  annotation = {11 citations (INSPIRE 2023/11/16)\\
8 citations w/o self (INSPIRE 2023/11/16)},
  file = {C:\Users\dreyn\Zotero\storage\QGLEW4GJ\PhysRevApplied.17.html}
}

@article{ahnSuperconductingCavityHigh2020,
  title = {Superconducting Cavity in a High Magnetic Field},
  author = {Ahn, Danho and Kwon, Ohjoon and Chung, Woohyun and Jang, Wonjun and Lee, Doyu and Lee, Jhinhwan and Youn, Sung Woo and Youm, Dojun and Semertzidis, Yannis K.},
  date = {2020-04-27},
  journaltitle = {arXiv:2002.08769 [physics.app-ph]},
  doi = {10.48550/arXiv.2002.08769},
  url = {http://arxiv.org/abs/2002.08769},
  urldate = {2023-11-16},
  abstract = {A high Q-factor microwave resonator in a high magnetic field could be used in a wide range of applications, especially for enhancing the scanning speed in axion dark matter research. In this letter, we introduce a polygon-shaped resonant cavity with commercial YBCO tapes covering the entire inner wall. We demonstrated that the maximum Q-factor (TM\$\_\{010\}\$, 6.93 GHz) of the superconducting YBCO cavity was about 6 times higher than that of a copper cavity and showed no significant degradation up to 8 T at 4 K. This is the first indication of the possible applications of HTS technology to the research areas requiring low loss in a strong magnetic field at high radio frequencies.},
  keywords = {Condensed Matter - Superconductivity,High Energy Physics - Experiment,Physics - Applied Physics,Physics - Instrumentation and Detectors},
