@article{Talantsev:2023zgm,
  title = {Characteristic Length for Pinning Force Density in {{Nb}}{\textsubscript{3}}{{Sn}}},
  author = {Talantsev, E. F. and Valova-Zaharevskaya, E. G. and Deryagina, I. L. and Popova, E. N.},
  date = {2023-06-22},
  journaltitle = {arXiv:2306.13071 [cond-mat.supr-con]},
  eprint = {2306.13071},
  eprinttype = {arXiv},
  eprintclass = {cond-mat.supr-con},
  doi = {10.3390/ma16145185},
  url = {http://arxiv.org/abs/2306.13071},
  urldate = {2023-06-27},
  abstract = {The pinning force density \$F\{\_p\}(J\{\_c\},B)=J\{\_c\} \textbackslash times B\$ (where \$J\_c\$ is the critical current density and \$B\$ is the magnetic field) is one of the main parameters that characterize the resilience of a superconductor to carry a dissipative-free transport current in an applied magnetic field. Kramer (1973 J.Appl.Phys. 44 1360), and Dew-Hughes (1974 Phil.Mag. 30 293) proposed a widely used scaling law for the pinning force density amplitude: \$F\{\_p\}(B)=F\{\_\{p,max\}\}((p+q)\{\textasciicircum\{(p+q)\}\}/(\{p\textasciicircum p\}\{q\textasciicircum q\}))(B/B\_\{c2\})\{\textasciicircum p\}(1-B/B\{\_\{c2\}\})\textasciicircum q\$, where \$F\{\_\{p,max\}\}\$, \$B\{\_\{c2\}\}\$, \$p\$, and \$q\$ are free-fitting parameters. Since the late 1970-s till now, several research groups have reported experimental data on the dependence of \$F\_\{p,max\}\$ on the average grain size, \$d\$, in \$Nb\{\_3\}Sn\$-based conductors. Godeke (2006 Superc.Sci.Techn. 19 R68) proposed that the dependence obeys the law \$|F\{\_\{p,max\}\}(d)|=A \textbackslash times ln(1/d)+B \$. However, this scaling law has several problems, for instance, the logarithm is taken from a non-dimensionless variable, and \$|F\{\_\{p,max\}\}(d)|{$<$} 0 \$ for large grain sizes and \$|F\{\_\{p,max\}\}(d)|\textbackslash rightarrow \textbackslash infty \$ for \$d \textbackslash rightarrow 0\$. Here we reanalysed the full inventory of publicly available \$|F\{\_\{p,max\}\}(d)|\$ data for \$Nb\{\_3\}Sn\$ conductors and found that the dependence can be described by \$F\_\{p,max\}(d)= F\_\{p,max\}(0)exp(-d/\{\textbackslash delta\})\$ law, where the characteristic length, \$\{\textbackslash delta\}\$, varies within a remarkably narrow range, that is, \$\{\textbackslash delta\}=(175 \textbackslash pm 13) nm\$, for samples fabricated by different technologies. The interpretation of the result is based on the idea that the in-field supercurrent flows within a thin surface layer (thickness of \$\{\textbackslash delta\}\$) near the grain boundary surfaces. An alternative interpretation is that \$\{\textbackslash delta\}\$ represents characteristic length of the exponential decay flux pinning potential from the dominant defects in \$Nb\{\_3\}Sn\$ superconductors, which are grain boundaries.},
  keywords = {Condensed Matter - Superconductivity,Physics - Applied Physics},
  annotation = {0 citations (INSPIRE 2023/6/27)\\
0 citations w/o self (INSPIRE 2023/6/27)},
  file = {C\:\\Users\\dreyn\\Zotero\\storage\\UFCBSDLM\\Talantsev et al. - 2023 - Characteristic length for pinning force density in.pdf;C\:\\Users\\dreyn\\Zotero\\storage\\VWCRGTH7\\2306.html}
}

