  issn = {2470-0010, 2470-0029},
  doi = {10.1103/PhysRevD.99.101101},
  url = {https://link.aps.org/doi/10.1103/PhysRevD.99.101101},
  urldate = {2023-10-17},
  abstract = {To account for the dark matter content in our Universe, post-inflationary scenarios predict for the QCD axion a mass in the range \$(10-10\textasciicircum 3)\textbackslash,\textbackslash mu\textbackslash mbox\{eV\}\$. Searches with haloscope experiments in this mass range require the monitoring of resonant cavity modes with frequency above 5\textbackslash,GHz, where several experimental limitations occur due to linear amplifiers, small volumes, and low quality factors of Cu resonant cavities. In this paper we deal with the last issue, presenting the result of a search for galactic axions using a haloscope based on a \$36\textbackslash,\textbackslash mbox\{cm\}\textasciicircum 3\$ NbTi superconducting cavity. The cavity worked at \$T=4\textbackslash,\textbackslash mbox\{K\}\$ in a 2\textbackslash,T magnetic field and exhibited a quality factor \$Q\_0= 4.5\textbackslash times10\textasciicircum 5\$ for the TM010 mode at 9\textbackslash,GHz. With such values of \$Q\$ the axion signal is significantly increased with respect to copper cavity haloscopes. Operating this setup we set the limit \$g\_\{a\textbackslash gamma\textbackslash gamma\}{$<$}1.03\textbackslash times10\textasciicircum\{-12\}\textbackslash,\textbackslash mbox\{GeV\}\textasciicircum\{-1\}\$ on the axion photon coupling for a mass of about 37\textbackslash,\$\textbackslash mu\$eV. A comprehensive study of the NbTi cavity at different magnetic fields, temperatures, and frequencies is also presented.},
  langid = {english},
  annotation = {115 citations (INSPIRE 2023/10/17)\\
92 citations w/o self (INSPIRE 2023/10/17)},
  file = {C\:\\Users\\dreyn\\Zotero\\storage\\EAAK8FST\\Alesini et al. - 2019 - Galactic axions search with a superconducting reso.pdf;C\:\\Users\\dreyn\\Zotero\\storage\\F2X7C5XM\\Alesini et al. - 2019 - Galactic axions search with a superconducting reso.pdf}
}

